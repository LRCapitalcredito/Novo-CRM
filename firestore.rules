rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /lr_v2_workspaces/{workspace} {
      function signedIn() { return request.auth != null; }
      function member() { return get(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/members/$(request.auth.uid)).data; }
      function active() { return signedIn() && member().active == true && member().role in ['admin','editor','reader']; }
      function editor() { return active() && member().role in ['admin','editor']; }
      function admin() { return active() && member().role == 'admin'; }
      function text(v,max) { return v is string && v.size() <= max; }
      function money(v) { return v == null || (v is int && v >= 0 && v <= 1000000000000000); }
      function summary(v) { return {'company':v.company,'stage':v.stage,'product':v.product,'requestedCents':v.requestedCents,'approvedCents':v.approvedCents,'nextAction':v.nextAction,'dueDate':v.dueDate,'version':v.version}; }
      function validOperation(v,id) {
        return v.keys().hasAll(['id','company','cnpj','contact','email','phone','product','stage','owner','requestedCents','approvedCents','revenueCents','nextAction','dueDate','institution','notes','version','createdAt','updatedAt','updatedBy','lastEventId'])
          && v.keys().hasOnly(['id','company','cnpj','contact','email','phone','product','stage','owner','requestedCents','approvedCents','revenueCents','nextAction','dueDate','institution','notes','version','createdAt','updatedAt','updatedBy','lastEventId'])
          && v.id == id && id.matches('^[a-zA-Z0-9_-]{6,80}$')
          && text(v.company,160) && v.company.size()>0
          && text(v.owner,100) && v.owner.size()>0
          && text(v.cnpj,18) && text(v.contact,120) && text(v.email,180) && text(v.phone,40)
          && v.product in ["Capital de giro", "Antecipação de recebíveis", "Home equity", "Financiamento", "Crédito estruturado", "Reestruturação de dívida", "Crédito rural", "Outras modalidades", "Não informado"]
          && v.stage in ["Novo", "Documentação", "Análise", "Mesa de crédito", "Aprovado", "Liberado", "Retomada", "Questionário", "Contrato Assinado", "Pagamento Recebido", "Captação de Documentos", "Triagem e Validação", "Diagnóstico Estratégico", "Análise Bancos", "Mesa de Crédito", "Aprovado / Negado", "Assinatura Banco", "Crédito na Conta", "Parado", "Perdido", "Sem Interesse", "Novo Cliente", "Reunião Agendada", "Reunião Realizada", "Aguardando Assinatura", "Enviar E-mail", "E-mail Enviado", "WhatsApp Enviado", "Apresentar para o gerente", "No Show", "Contrato", "Lead", "sem_restricao", "com_restricao", "Negado"]
          && money(v.requestedCents) && money(v.approvedCents) && money(v.revenueCents)
          && text(v.nextAction,12000) && text(v.dueDate,10) && (v.dueDate == '' || v.dueDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'))
          && text(v.institution,160) && text(v.notes,12000)
          && v.version is int && v.version>=1
          && v.createdAt is timestamp && v.updatedAt == request.time && v.updatedBy == request.auth.uid
          && text(v.lastEventId,80) && v.lastEventId.size()>0;
      }
      function hasAudit(v,id) {
        let event = getAfter(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/activities/$(v.lastEventId)).data;
        return event.operationId == id && event.operationVersion == v.version && event.actorUid == request.auth.uid && event.at == request.time;
      }
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || admin());
        allow list: if admin();
        allow create: if claimMember(uid);
        allow update: if admin() && uid != request.auth.uid && resource.data.role != 'admin'
          && request.resource.data.keys().hasAll(['name','role','active'])
          && request.resource.data.keys().hasOnly(['name','role','active','email'])
          && text(request.resource.data.name,100) && request.resource.data.name.size()>0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','role'])
          && request.resource.data.role in ['editor','reader'] && request.resource.data.active is bool;
        allow delete: if false;
      }
      function googleIdentity(email) {
        return signedIn() && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email.lower() == email;
      }
      function claimMember(uid) {
        let m=request.resource.data;
        let invite=get(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/invitations/$(m.email)).data;
        let after=getAfter(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/invitations/$(m.email)).data;
        return uid==request.auth.uid && googleIdentity(m.email)
          && m.keys().hasOnly(['name','email','role','active']) && m.active==true
          && m.name==invite.name && m.role==invite.role && m.role in ['editor','reader']
          && invite.active==true && invite.claimedUid=='' && after.claimedUid==uid;
      }
      function validInvite(v,email) {
        return v.keys().hasAll(['email','name','role','active','claimedUid','version','createdAt','updatedAt','updatedBy'])
          && v.keys().hasOnly(['email','name','role','active','claimedUid','version','createdAt','updatedAt','updatedBy'])
          && text(v.email,180) && v.email==email && email==email.lower() && email.matches('^[^ @/]+@[^ @/]+[.][^ @/]+$')
          && text(v.name,100) && v.name.size()>0 && v.role in ['editor','reader'] && v.active is bool
          && v.claimedUid is string && v.version is int && v.updatedAt==request.time && v.updatedBy==request.auth.uid;
      }
      match /invitations/{email} {
        allow get: if admin() || googleIdentity(email);
        allow list: if admin();
        allow create: if admin() && validInvite(request.resource.data,email) && request.resource.data.version==1 && request.resource.data.createdAt==request.time && request.resource.data.claimedUid=='';
        allow update: if validInvite(request.resource.data,email)
          && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.version==resource.data.version+1
          && ((admin() && resource.data.claimedUid=='' && request.resource.data.claimedUid=='')
            || (googleIdentity(email) && resource.data.active==true && resource.data.claimedUid==''
              && request.resource.data.claimedUid==request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedUid','version','updatedAt','updatedBy'])
              && !exists(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/members/$(request.auth.uid))
              && getAfter(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/members/$(request.auth.uid)).data.email==email));
        allow delete: if false;
      }
      match /driveFolders/{id} {
        allow read: if active();
        allow write: if false;
      }
      match /operations/{id} {
        allow get,list: if active();
        allow create: if editor() && validOperation(request.resource.data,id) && request.resource.data.version==1 && request.resource.data.createdAt==request.time && hasAudit(request.resource.data,id);
        allow update: if editor() && validOperation(request.resource.data,id) && request.resource.data.version==resource.data.version+1 && request.resource.data.createdAt==resource.data.createdAt && hasAudit(request.resource.data,id);
        allow delete: if false;
      }
      function optionalNumber(v,max) { return v==null || (v is number && v>=0 && v<=max); }
      function warrantyValue(g) {
        let term=g.termMonths;
        let ltv=g.ltvPercent;
        return g.keys().hasOnly(['rate','termMonths','ltvPercent'])
          && g.rate.matches('^[\\s\\S]{0,80}$')
          && (term==null || (term is int && term>=0 && term<=600))
          && (ltv==null || (ltv is number && ltv>=0 && ltv<=100));
      }
      function warranty(m,k) { return !(k in m) || warrantyValue(m[k]); }
      function guarantees(m) {
        return m is map && m.keys().hasOnly(['Imóveis (Geral)','Imóvel Urbano','Imóvel Rural','Imóvel Operacional','Veículos Leves','Veículos Pesados','Recebíveis','Contratos','Aplicação Financeira','Aval / Fiador','Estoque','FGI / Limpa','Safra','Câmbio','Universal'])
        && warranty(m,'Imóveis (Geral)') && warranty(m,'Imóvel Urbano') && warranty(m,'Imóvel Rural') && warranty(m,'Imóvel Operacional') && warranty(m,'Veículos Leves') && warranty(m,'Veículos Pesados') && warranty(m,'Recebíveis');
      }
      function remainingGuarantees(m) {
        return warranty(m,'Contratos') && warranty(m,'Aplicação Financeira') && warranty(m,'Aval / Fiador') && warranty(m,'Estoque') && warranty(m,'FGI / Limpa') && warranty(m,'Safra') && warranty(m,'Câmbio') && warranty(m,'Universal');
      }
      function validDirectory(v,id) {
        return v.keys().hasAll(['id','kind','name','notes','source','archived','version','createdAt','updatedAt','updatedBy','lastEventId'])
          && v.id==id && id.matches('^[a-zA-Z0-9_-]{6,100}$') && text(v.name,160) && v.name.size()>0
          && text(v.notes,12000) && text(v.source,300) && v.archived is bool
          && v.version is int && v.version>=1 && v.createdAt is timestamp && v.updatedAt==request.time && v.updatedBy==request.auth.uid
          && text(v.lastEventId,80) && v.lastEventId.size()>0
          && (v.kind=='bank' ? validBank(v) : (v.kind=='manager' && validManager(v)));
      }
      function validBank(v) {
        return v.keys().hasAll(['type','color','logoUrl','acceptsRestriction','guarantees'])
          && v.keys().hasOnly(['id','kind','name','notes','source','archived','version','createdAt','updatedAt','updatedBy','lastEventId','type','color','logoUrl','acceptsRestriction','guarantees'])
          && text(v.type,100) && text(v.color,7) && v.color.matches('^#[0-9a-fA-F]{6}$') && text(v.logoUrl,2000) && (v.logoUrl=='' || v.logoUrl.matches('^https://[^\\s]+$'))
          && (v.acceptsRestriction==null || v.acceptsRestriction is bool) && guarantees(v.guarantees);
      }
      function validSegments(v) { return v is list && v.size()<=30 && (v.size()<=0 || (text(v[0],120) && v[0].size()>0)) && (v.size()<=1 || (text(v[1],120) && v[1].size()>0)) && (v.size()<=2 || (text(v[2],120) && v[2].size()>0)) && (v.size()<=3 || (text(v[3],120) && v[3].size()>0)) && (v.size()<=4 || (text(v[4],120) && v[4].size()>0)) && (v.size()<=5 || (text(v[5],120) && v[5].size()>0)) && (v.size()<=6 || (text(v[6],120) && v[6].size()>0)) && (v.size()<=7 || (text(v[7],120) && v[7].size()>0)) && (v.size()<=8 || (text(v[8],120) && v[8].size()>0)) && (v.size()<=9 || (text(v[9],120) && v[9].size()>0)) && (v.size()<=10 || (text(v[10],120) && v[10].size()>0)) && (v.size()<=11 || (text(v[11],120) && v[11].size()>0)) && (v.size()<=12 || (text(v[12],120) && v[12].size()>0)) && (v.size()<=13 || (text(v[13],120) && v[13].size()>0)) && (v.size()<=14 || (text(v[14],120) && v[14].size()>0)) && (v.size()<=15 || (text(v[15],120) && v[15].size()>0)) && (v.size()<=16 || (text(v[16],120) && v[16].size()>0)) && (v.size()<=17 || (text(v[17],120) && v[17].size()>0)) && (v.size()<=18 || (text(v[18],120) && v[18].size()>0)) && (v.size()<=19 || (text(v[19],120) && v[19].size()>0)) && (v.size()<=20 || (text(v[20],120) && v[20].size()>0)) && (v.size()<=21 || (text(v[21],120) && v[21].size()>0)) && (v.size()<=22 || (text(v[22],120) && v[22].size()>0)) && (v.size()<=23 || (text(v[23],120) && v[23].size()>0)) && (v.size()<=24 || (text(v[24],120) && v[24].size()>0)) && (v.size()<=25 || (text(v[25],120) && v[25].size()>0)) && (v.size()<=26 || (text(v[26],120) && v[26].size()>0)) && (v.size()<=27 || (text(v[27],120) && v[27].size()>0)) && (v.size()<=28 || (text(v[28],120) && v[28].size()>0)) && (v.size()<=29 || (text(v[29],120) && v[29].size()>0)); }
      function validManager(v) {
        return v.keys().hasAll(['bankId','minRevenueCents','maxRevenueCents','email','phone','city','state','serviceScope','radiusKm','servedStates'])
          && v.keys().hasOnly(['id','kind','name','notes','source','archived','version','createdAt','updatedAt','updatedBy','lastEventId','bankId','minRevenueCents','maxRevenueCents','email','phone','city','state','serviceScope','radiusKm','servedStates','targetSegments'])
          && (!('targetSegments' in v) || validSegments(v.targetSegments))
          && text(v.bankId,100) && v.bankId.matches('^[a-zA-Z0-9_-]{6,100}$') && getAfter(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/directory/$(v.bankId)).data.kind=='bank'
          && money(v.minRevenueCents) && money(v.maxRevenueCents) && (v.minRevenueCents==null || v.maxRevenueCents==null || v.minRevenueCents<=v.maxRevenueCents)
          && text(v.email,180) && text(v.phone,40) && text(v.city,120) && text(v.state,2)
          && v.state in ['','AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO']
          && v.serviceScope in ['','city','radius','states','national'] && optionalNumber(v.radiusKm,20000)
          && v.servedStates is list && v.servedStates.size()<=27 && v.servedStates.hasOnly(['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'])
          && (v.serviceScope!='states'||v.servedStates.size()>0) && (v.serviceScope!='radius'||(v.radiusKm>0 && v.city.size()>0 && v.state.size()>0));
      }
      function hasDirectoryAudit(v,id) {
        let e=getAfter(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/directoryEvents/$(v.lastEventId)).data;
        return e.entityId==id && e.version==v.version && e.at==request.time && e.actorUid==request.auth.uid;
      }
      match /directory/{id} {
        allow get,list: if active();
        allow create: if request.resource.data.version==1 && request.resource.data.createdAt==request.time && editor() && validDirectory(request.resource.data,id) && hasDirectoryAudit(request.resource.data,id);
        allow update: if request.resource.data.version==resource.data.version+1 && request.resource.data.kind==resource.data.kind && request.resource.data.createdAt==resource.data.createdAt && editor() && validDirectory(request.resource.data,id) && hasDirectoryAudit(request.resource.data,id);
        allow delete: if false;
      }
      match /directoryEvents/{eventId} {
        function validDirectoryEvent(e) {
          let target=/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/directory/$(e.entityId);
          let v=getAfter(target).data;
          let ignore=['id','kind','version','createdAt','updatedAt','updatedBy','lastEventId'].toSet();
          let changed=exists(target)?v.diff(get(target).data).affectedKeys().difference(ignore):v.keys().toSet().difference(ignore);
          // Both documents must be written atomically. Split guarantee checks across
          // their rules to stay within Firestore's expression limit per write.
          // The directory rule requires this new event, and an event cannot be reused.
          return v.lastEventId==eventId && e.kind==v.kind && e.name==v.name && e.version==v.version && e.changes is list && e.changes.toSet()==changed
            && (v.kind!='bank' || remainingGuarantees(v.guarantees));
        }
        allow get,list: if active();
        allow create: if editor() && request.resource.data.keys().hasAll(['entityId','kind','name','actor','actorUid','at','version','changes']) && request.resource.data.keys().hasOnly(['entityId','kind','name','actor','actorUid','at','version','changes']) && request.resource.data.actorUid==request.auth.uid && request.resource.data.actor==member().name && request.resource.data.at==request.time && validDirectoryEvent(request.resource.data);
        allow update,delete: if false;
      }
      function validRecord(v,id) {
        return v.keys().hasAll(['id','kind','operationId','contentJson','version','createdAt','updatedAt','updatedBy','lastEventId'])
          && v.keys().hasOnly(['id','kind','operationId','contentJson','version','createdAt','updatedAt','updatedBy','lastEventId'])
          && v.id==id && id.matches('^[a-zA-Z0-9_-]{6,100}$')
          && v.kind in ['profile','placement','contract','diagnosis','template','simulation','document','task','dispatch']
          && (v.kind=='template' ? (v.operationId=='' && admin()) : (v.operationId.matches('^[a-zA-Z0-9_-]{6,80}$') && existsAfter(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/operations/$(v.operationId))))
          && text(v.contentJson,150000) && v.contentJson.size()>1
          && v.version is int && v.version>=1 && v.createdAt is timestamp && v.updatedAt==request.time && v.updatedBy==request.auth.uid
          && text(v.lastEventId,80) && v.lastEventId.size()>0;
      }
      function hasRecordAudit(v,id) {
        let e=getAfter(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/recordEvents/$(v.lastEventId)).data;
        return e.recordId==id && e.operationId==v.operationId && e.kind==v.kind && e.version==v.version && e.at==request.time && e.actorUid==request.auth.uid;
      }
      match /records/{id} {
        allow get,list: if active();
        allow create: if editor() && validRecord(request.resource.data,id) && request.resource.data.version==1 && request.resource.data.createdAt==request.time && hasRecordAudit(request.resource.data,id);
        allow update: if editor() && validRecord(request.resource.data,id) && request.resource.data.kind==resource.data.kind && request.resource.data.operationId==resource.data.operationId && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.version==resource.data.version+1 && hasRecordAudit(request.resource.data,id);
        allow delete: if false;
      }
      match /recordEvents/{eventId} {
        function validRecordEvent(e) {
          let v=getAfter(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/records/$(e.recordId)).data;
          return v.lastEventId==eventId && e.operationId==v.operationId && e.kind==v.kind && e.version==v.version
            && (v.kind in ['document','task','dispatch'] ? (e.keys().hasAll(['contentJson']) && e.contentJson==v.contentJson) : !e.keys().hasAny(['contentJson']));
        }
        allow get,list: if active();
        allow create: if editor() && request.resource.data.keys().hasAll(['recordId','operationId','kind','actor','actorUid','at','version']) && request.resource.data.keys().hasOnly(['recordId','operationId','kind','actor','actorUid','at','version','contentJson']) && request.resource.data.actor==member().name && request.resource.data.actorUid==request.auth.uid && request.resource.data.at==request.time && validRecordEvent(request.resource.data);
        allow update,delete: if false;
      }
      match /activities/{eventId} {
        allow get,list: if active();
        allow create: if editor()
          && request.resource.data.keys().hasAll(['operationId','company','actor','actorUid','at','action','before','after','operationVersion'])
          && request.resource.data.keys().hasOnly(['operationId','company','actor','actorUid','at','action','before','after','operationVersion'])
          && request.resource.data.actorUid==request.auth.uid && request.resource.data.actor==member().name
          && request.resource.data.at==request.time
          && validEvent(request.resource.data,eventId);
        function validEvent(e,eventId) {
          let opPath=/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/operations/$(e.operationId);
          let op=getAfter(opPath).data;
          return op.lastEventId==eventId && op.version==e.operationVersion
            && e.company==op.company && e.after==summary(op)
            && (exists(opPath) ? (e.before==summary(get(opPath).data) && e.action=='Operação atualizada') : (e.before==null && e.action=='Operação criada'));
        }
        allow update,delete: if false;
      }
    }
  }
}
