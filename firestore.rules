rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /lr_v2_workspaces/{workspace} {
      function signedIn() { return request.auth != null; }
      function member() { return get(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/members/$(request.auth.uid)).data; }
      function active() { return signedIn() && member().active == true && member().role in ['admin','editor','reader']; }
      function editor() { return active() && member().role in ['admin','editor']; }
      function admin() { return active() && member().role == 'admin'; }
      function text(v,max) { return v is string && v.size() <= max; }
      function money(v) { return v == null || (v is int && v >= 0 && v <= 1000000000000000); }
      function summary(v) { return {'company':v.company,'stage':v.stage,'requestedCents':v.requestedCents,'approvedCents':v.approvedCents,'nextAction':v.nextAction,'dueDate':v.dueDate,'version':v.version}; }
      function validOperation(v,id) {
        return v.keys().hasAll(['id','company','cnpj','contact','email','phone','product','stage','owner','requestedCents','approvedCents','revenueCents','nextAction','dueDate','institution','notes','version','createdAt','updatedAt','updatedBy','lastEventId'])
          && v.keys().hasOnly(['id','company','cnpj','contact','email','phone','product','stage','owner','requestedCents','approvedCents','revenueCents','nextAction','dueDate','institution','notes','version','createdAt','updatedAt','updatedBy','lastEventId'])
          && v.id == id && id.matches('^[a-zA-Z0-9_-]{6,80}$')
          && text(v.company,160) && v.company.size()>0
          && text(v.owner,100) && v.owner.size()>0
          && text(v.cnpj,18) && text(v.contact,120) && text(v.email,180) && text(v.phone,40)
          && v.product in ['Capital de giro','Antecipação de recebíveis','Home equity','Financiamento']
          && v.stage in ['Novo','Documentação','Análise','Mesa de crédito','Aprovado','Liberado','Retomada']
          && money(v.requestedCents) && money(v.approvedCents) && money(v.revenueCents)
          && text(v.nextAction,500) && text(v.dueDate,10) && (v.dueDate == '' || v.dueDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'))
          && text(v.institution,160) && text(v.notes,12000)
          && v.version is int && v.version>=1
          && v.createdAt is timestamp && v.updatedAt == request.time && v.updatedBy == request.auth.uid
          && text(v.lastEventId,80) && v.lastEventId.size()>0;
      }
      function hasAudit(v,id) {
        let event = getAfter(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/activities/$(v.lastEventId)).data;
        return event.operationId == id && event.operationVersion == v.version && event.actorUid == request.auth.uid && event.at == request.time;
      }
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || admin());
        allow list: if admin();
        allow create, update: if admin()
          && request.resource.data.keys().hasAll(['name','role','active'])
          && request.resource.data.keys().hasOnly(['name','role','active'])
          && text(request.resource.data.name,100) && request.resource.data.name.size()>0
          && request.resource.data.role in ['admin','editor','reader'] && request.resource.data.active is bool;
        allow delete: if false;
      }
      match /operations/{id} {
        allow get,list: if active();
        allow create: if editor() && validOperation(request.resource.data,id) && request.resource.data.version==1 && request.resource.data.createdAt==request.time && hasAudit(request.resource.data,id);
        allow update: if editor() && validOperation(request.resource.data,id) && request.resource.data.version==resource.data.version+1 && request.resource.data.createdAt==resource.data.createdAt && hasAudit(request.resource.data,id);
        allow delete: if false;
      }
      function optionalNumber(v,max) { return v==null || (v is number && v>=0 && v<=max); }
      function warrantyValue(g) {
        let term=g.termMonths;
        let ltv=g.ltvPercent;
        return g.size()==3 && g.keys().hasOnly(['rate','termMonths','ltvPercent'])
          && g.rate.matches('^[\\s\\S]{0,80}$')
          && (term==null || (term is int && term>=0 && term<=600))
          && (ltv==null || (ltv is number && ltv>=0 && ltv<=100));
      }
      function warranty(m,k) { return !(k in m) || warrantyValue(m[k]); }
      function guarantees(m) {
        return m is map && m.keys().hasOnly(['Imóveis (Geral)','Imóvel Urbano','Imóvel Rural','Imóvel Operacional','Veículos Leves','Veículos Pesados','Recebíveis','Contratos','Aplicação Financeira','Aval / Fiador','Estoque','FGI / Limpa','Safra','Câmbio','Universal'])
        && warranty(m,'Imóveis (Geral)') && warranty(m,'Imóvel Urbano') && warranty(m,'Imóvel Rural') && warranty(m,'Imóvel Operacional') && warranty(m,'Veículos Leves') && warranty(m,'Veículos Pesados') && warranty(m,'Recebíveis') && warranty(m,'Contratos') && warranty(m,'Aplicação Financeira') && warranty(m,'Aval / Fiador') && warranty(m,'Estoque') && warranty(m,'FGI / Limpa') && warranty(m,'Safra') && warranty(m,'Câmbio') && warranty(m,'Universal');
      }
      function validDirectory(v,id) {
        return v.keys().hasAll(['id','kind','name','notes','source','archived','version','createdAt','updatedAt','updatedBy','lastEventId'])
          && v.id==id && id.matches('^[a-zA-Z0-9_-]{6,100}$') && text(v.name,160) && v.name.size()>0
          && text(v.notes,12000) && text(v.source,300) && v.archived is bool
          && v.version is int && v.version>=1 && v.createdAt is timestamp && v.updatedAt==request.time && v.updatedBy==request.auth.uid
          && text(v.lastEventId,80) && v.lastEventId.size()>0
          && (v.kind=='bank' ? validBank(v) : (v.kind=='manager' && validManager(v)));
      }
      function validBank(v) {
        return v.keys().hasAll(['type','color','logoUrl','acceptsRestriction','guarantees'])
          && v.keys().hasOnly(['id','kind','name','notes','source','archived','version','createdAt','updatedAt','updatedBy','lastEventId','type','color','logoUrl','acceptsRestriction','guarantees'])
          && text(v.type,100) && text(v.color,7) && v.color.matches('^#[0-9a-fA-F]{6}$') && text(v.logoUrl,2000) && (v.logoUrl=='' || v.logoUrl.matches('^https://[^\\s]+$'))
          && (v.acceptsRestriction==null || v.acceptsRestriction is bool) && guarantees(v.guarantees);
      }
      function validManager(v) {
        return v.keys().hasAll(['bankId','minRevenueCents','maxRevenueCents','email','phone','city','state','serviceScope','radiusKm','servedStates'])
          && v.keys().hasOnly(['id','kind','name','notes','source','archived','version','createdAt','updatedAt','updatedBy','lastEventId','bankId','minRevenueCents','maxRevenueCents','email','phone','city','state','serviceScope','radiusKm','servedStates'])
          && text(v.bankId,100) && v.bankId.matches('^[a-zA-Z0-9_-]{6,100}$') && getAfter(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/directory/$(v.bankId)).data.kind=='bank'
          && money(v.minRevenueCents) && money(v.maxRevenueCents) && (v.minRevenueCents==null || v.maxRevenueCents==null || v.minRevenueCents<=v.maxRevenueCents)
          && text(v.email,180) && text(v.phone,40) && text(v.city,120) && text(v.state,2)
          && v.state in ['','AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO']
          && v.serviceScope in ['','city','radius','states','national'] && optionalNumber(v.radiusKm,20000)
          && v.servedStates is list && v.servedStates.size()<=27 && v.servedStates.hasOnly(['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'])
          && (v.serviceScope!='states'||v.servedStates.size()>0) && (v.serviceScope!='radius'||(v.radiusKm>0 && v.city.size()>0 && v.state.size()>0));
      }
      function hasDirectoryAudit(v,id) {
        let e=getAfter(/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/directoryEvents/$(v.lastEventId)).data;
        return e.entityId==id && e.version==v.version && e.at==request.time && e.actorUid==request.auth.uid;
      }
      match /directory/{id} {
        allow get,list: if active();
        allow create: if request.resource.data.version==1 && request.resource.data.createdAt==request.time && editor() && validDirectory(request.resource.data,id) && hasDirectoryAudit(request.resource.data,id);
        allow update: if request.resource.data.version==resource.data.version+1 && request.resource.data.kind==resource.data.kind && request.resource.data.createdAt==resource.data.createdAt && editor() && validDirectory(request.resource.data,id) && hasDirectoryAudit(request.resource.data,id);
        allow delete: if false;
      }
      match /directoryEvents/{eventId} {
        function validDirectoryEvent(e) {
          let target=/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/directory/$(e.entityId);
          let v=getAfter(target).data;
          let ignore=['id','kind','version','createdAt','updatedAt','updatedBy','lastEventId'].toSet();
          let changed=exists(target)?v.diff(get(target).data).affectedKeys().difference(ignore):v.keys().toSet().difference(ignore);
          return v.lastEventId==eventId && e.kind==v.kind && e.name==v.name && e.version==v.version && e.changes is list && e.changes.toSet()==changed;
        }
        allow get,list: if active();
        allow create: if editor() && request.resource.data.keys().hasAll(['entityId','kind','name','actor','actorUid','at','version','changes']) && request.resource.data.keys().hasOnly(['entityId','kind','name','actor','actorUid','at','version','changes']) && request.resource.data.actorUid==request.auth.uid && request.resource.data.actor==member().name && request.resource.data.at==request.time && validDirectoryEvent(request.resource.data);
        allow update,delete: if false;
      }
      match /activities/{eventId} {
        allow get,list: if active();
        allow create: if editor()
          && request.resource.data.keys().hasAll(['operationId','company','actor','actorUid','at','action','before','after','operationVersion'])
          && request.resource.data.keys().hasOnly(['operationId','company','actor','actorUid','at','action','before','after','operationVersion'])
          && request.resource.data.actorUid==request.auth.uid && request.resource.data.actor==member().name
          && request.resource.data.at==request.time
          && validEvent(request.resource.data,eventId);
        function validEvent(e,eventId) {
          let opPath=/databases/$(database)/documents/lr_v2_workspaces/$(workspace)/operations/$(e.operationId);
          let op=getAfter(opPath).data;
          return op.lastEventId==eventId && op.version==e.operationVersion
            && e.company==op.company && e.after==summary(op)
            && (exists(opPath) ? (e.before==summary(get(opPath).data) && e.action=='Operação atualizada') : (e.before==null && e.action=='Operação criada'));
        }
        allow update,delete: if false;
      }
    }
  }
}
